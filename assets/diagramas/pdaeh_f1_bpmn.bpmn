<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PDAEH-F2-general-v1" targetNamespace="http://pdaeh.org/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.1">
  <collaboration id="Collab_F2">
    <participant id="Pool_F2" name="F1. Definición estratégica." processRef="Process_F2" />
    <participant id="Pool_OGA_F2" name="Órgano de gobierno arquitectónico (OGA)" processRef="Process_OGA_F2" />
    <messageFlow id="Flow_1jkls22" sourceRef="Task_F2_send" targetRef="Event_0f3xrhd" />
    <messageFlow id="Flow_024sk3l" sourceRef="Event_0eupdqb" targetRef="Task_F2_adjust" />
  </collaboration>
  <process id="Process_F2" name="Proceso F2 — Fundamentación Conceptual" isExecutable="true">
    <laneSet id="LaneSet_F2">
      <lane id="Lane_AEP_F2" name="AEP — Arquitecto empresarial del proceso / SE / GPA — Stakeholder Empresarial / Gestor de Portafolio">
        <flowNodeRef>StartEvent_F2</flowNodeRef>
        <flowNodeRef>Gateway_F2_par_split</flowNodeRef>
        <flowNodeRef>CA_F2_E3</flowNodeRef>
        <flowNodeRef>CA_F2_E4</flowNodeRef>
        <flowNodeRef>Gateway_F2_par_join</flowNodeRef>
        <flowNodeRef>Task_F2_send</flowNodeRef>
        <flowNodeRef>Task_F2_adjust</flowNodeRef>
        <flowNodeRef>Gateway_F2_approval</flowNodeRef>
        <flowNodeRef>EndEvent_F2</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_F2" name="Inicio">
      <documentation>
        Inicio de F2 — Fundamentación Conceptual.
        Precondición: Línea Base F1 aprobada por el OGA.
        Artefactos disponibles: DOA-v1, MTA-v1, DCA-v1, SMP-v1.
        Se activan en paralelo los subprocesos E3 (Nivel de abstracción)
        y E4 (Vocabulario arquitectónico).
      </documentation>
      <outgoing>SF_F2_start_split</outgoing>
    </startEvent>
    <parallelGateway id="Gateway_F2_par_split" name="">
      <incoming>SF_F2_start_split</incoming>
      <outgoing>SF_F2_split_E3</outgoing>
      <outgoing>SF_F2_split_E4</outgoing>
    </parallelGateway>
    <callActivity id="CA_F2_E3" name="F1.E1. Objetivo de la arquitectura" calledElement="Process_F2_E3">
      <documentation>
        Subproceso E3. Ver detalle en PDAEH_f2_E3_bpmn_v1.xml.
        Entradas: DOA-v1, MTA-v1.
        Salidas: DPV-v1 (validado), DNA-v1, MTA-v2.
      </documentation>
      <incoming>SF_F2_split_E3</incoming>
      <outgoing>SF_F2_E3_join</outgoing>
      <property id="Prop_CA_E3" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_CA_E3_DOA">
        <sourceRef>DOR_DOA_F1</sourceRef>
        <targetRef>Prop_CA_E3</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_CA_E3_MTA2">
        <sourceRef>CA_F2_E3</sourceRef>
        <targetRef>DOR_MTA_F2</targetRef>
      </dataOutputAssociation>
    </callActivity>
    <callActivity id="CA_F2_E4" name="F1.E2. Contexto de la arquitectura" calledElement="Process_F2_E4">
      <documentation>
        Subproceso E4. Ver detalle en PDAEH_f2_E4_bpmn_v1.xml.
        Entradas: DOA-v1, DCA-v1, SMP-v1.
        Salidas: ITA-v1, DVA-v1 (validado).
      </documentation>
      <incoming>SF_F2_split_E4</incoming>
      <outgoing>SF_F2_E4_join</outgoing>
      <property id="Prop_CA_E4" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_CA_E4_DCA">
        <sourceRef>DOR_DCA_SMP</sourceRef>
        <targetRef>Prop_CA_E4</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_CA_E4_DVA">
        <sourceRef>CA_F2_E4</sourceRef>
        <targetRef>DOR_DVA</targetRef>
      </dataOutputAssociation>
    </callActivity>
    <parallelGateway id="Gateway_F2_par_join" name="">
      <incoming>SF_F2_E3_join</incoming>
      <incoming>SF_F2_E4_join</incoming>
      <outgoing>SF_F2_join_send</outgoing>
    </parallelGateway>
    <dataObjectReference id="DOR_DOA_F1" name="Plan Estratégico Institucional, Catálogo de iniciativas" dataObjectRef="DO_DOA_F1" />
    <dataObject id="DO_DOA_F1" name="DOA-v1" />
    <dataObjectReference id="DOR_DCA_SMP" name="Inventario AS-IS" dataObjectRef="DO_DCA_SMP" />
    <dataObject id="DO_DCA_SMP" name="DCA-v1 / SMP-v1" />
    <dataObjectReference id="DOR_DVA" name="DCA, MSP" dataObjectRef="DO_DVA" />
    <dataObject id="DO_DVA" name="DVA-v1" />
    <sendTask id="Task_F2_send" name="F1.E1.A4 {E2} Preparación y envío de artefactos al OGA" camunda:type="external" camunda:topic="OGA_Review_F2">
      <documentation>
        El AEP compila los artefactos producidos por E3 y E4:
          - DNA-v1 (Documento de Niveles de Abstracción)
          - MTA-v2 (Matriz de Trazabilidad actualizada)
          - DVA-v1 (Diccionario de Vocabulario Arquitectónico)
        Los consolida en la Línea Base F2 y los envía al OGA para revisión.
        Salida: LBA-F2-v1 (Línea Base F2, borrador para revisión OGA).
      </documentation>
      <incoming>SF_F2_join_send</incoming>
      <incoming>Flow_0qlrz7a</incoming>
      <outgoing>SF_F2_send_adjust</outgoing>
      <property id="Prop_send" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_send_MTA2">
        <sourceRef>DOR_MTA_F2</sourceRef>
        <targetRef>Prop_send</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_send_DVA">
        <sourceRef>DOR_DVA</sourceRef>
        <targetRef>Prop_send</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_1ynaooo">
        <targetRef>DataObjectReference_1xfwu34</targetRef>
      </dataOutputAssociation>
    </sendTask>
    <dataObjectReference id="DataObjectReference_1xfwu34" name="LBA-F1 inicial" dataObjectRef="DataObject_1ksaeuf" />
    <dataObject id="DataObject_1ksaeuf" />
    <userTask id="Task_F2_adjust" name="F1.E1.A5 {E2} Ajustar artefactos según observaciones del OGA" camunda:assignee="AEP">
      <documentation>
        El AEP recibe las observaciones emitidas por el OGA y determina:
          - Qué artefactos deben ser revisados (DNA-v1, DVA-v1 o MTA-v2).
          - En qué subproceso (E3 o E4) se originó la observación.
        Registra los ajustes requeridos y activa nuevamente el flujo paralelo
        para reejecutar los subprocesos afectados.
      </documentation>
      <incoming>SF_F2_send_adjust</incoming>
      <outgoing>Flow_02uooon</outgoing>
      <property id="Property_0608anz" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_1vn0j1d">
        <sourceRef>DataObjectReference_1xfwu34</sourceRef>
        <targetRef>Property_0608anz</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_0o6oc04">
        <targetRef>DataObjectReference_03w4pys</targetRef>
      </dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="Gateway_F2_approval" name="¿OGA aprueba los artefactos?">
      <incoming>Flow_02uooon</incoming>
      <outgoing>SF_F2_approval_yes</outgoing>
      <outgoing>Flow_0qlrz7a</outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_F2" name="Fin">
      <documentation>
        Fin de F2 — Fundamentación Conceptual.
        Línea Base F2 aprobada por el OGA.
        Artefactos consolidados: DPV-v1, DNA-v1, ITA-v1, DVA-v1, MTA-v2.
        La fase F3 — Especificación de Calidad puede iniciarse.
      </documentation>
      <incoming>SF_F2_approval_yes</incoming>
    </endEvent>
    <dataObjectReference id="DataObjectReference_03w4pys" name="LBA-F1 aprobado" dataObjectRef="DataObject_0dm0h4m" />
    <dataObject id="DataObject_0dm0h4m" />
    <dataObjectReference id="DOR_MTA_F2" name="MTA" dataObjectRef="DO_MTA_F2" />
    <dataObject id="DO_MTA_F2" name="MTA-v2" />
    <sequenceFlow id="SF_F2_start_split" sourceRef="StartEvent_F2" targetRef="Gateway_F2_par_split" />
    <sequenceFlow id="SF_F2_split_E3" sourceRef="Gateway_F2_par_split" targetRef="CA_F2_E3" />
    <sequenceFlow id="SF_F2_split_E4" sourceRef="Gateway_F2_par_split" targetRef="CA_F2_E4" />
    <sequenceFlow id="SF_F2_E3_join" sourceRef="CA_F2_E3" targetRef="Gateway_F2_par_join" />
    <sequenceFlow id="SF_F2_E4_join" sourceRef="CA_F2_E4" targetRef="Gateway_F2_par_join" />
    <sequenceFlow id="SF_F2_join_send" sourceRef="Gateway_F2_par_join" targetRef="Task_F2_send" />
    <sequenceFlow id="Flow_0qlrz7a" name="no" sourceRef="Gateway_F2_approval" targetRef="Task_F2_send" />
    <sequenceFlow id="SF_F2_send_adjust" name="La transición ocurre cuando se recibe la respuesta del OGA" sourceRef="Task_F2_send" targetRef="Task_F2_adjust" />
    <sequenceFlow id="Flow_02uooon" sourceRef="Task_F2_adjust" targetRef="Gateway_F2_approval" />
    <sequenceFlow id="SF_F2_approval_yes" name="sí" sourceRef="Gateway_F2_approval" targetRef="EndEvent_F2">
      <conditionExpression>OGA aprueba Línea Base F2</conditionExpression>
    </sequenceFlow>
  </process>
  <process id="Process_OGA_F2" name="Proceso OGA — Revisión F2" isExecutable="false">
    <laneSet id="LaneSet_OGA_F2">
      <lane id="Lane_OGA_F2">
        <flowNodeRef>Event_0f3xrhd</flowNodeRef>
        <flowNodeRef>Activity_0iwkjts</flowNodeRef>
        <flowNodeRef>Activity_07f19pr</flowNodeRef>
        <flowNodeRef>Gateway_17ie309</flowNodeRef>
        <flowNodeRef>Activity_0b1p9ep</flowNodeRef>
        <flowNodeRef>Activity_1wdvm5s</flowNodeRef>
        <flowNodeRef>Activity_0kvav8n</flowNodeRef>
        <flowNodeRef>Activity_1qvvdo6</flowNodeRef>
        <flowNodeRef>Gateway_0nan39s</flowNodeRef>
        <flowNodeRef>Event_0eupdqb</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Event_0f3xrhd" name="Recepción de artefactos">
      <outgoing>Flow_0i7zpzt</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0u8gnvu" />
    </startEvent>
    <dataObjectReference id="DataObjectReference_1nxneyy" name="LBA-F1 inicial" dataObjectRef="DataObject_0f0amhd" />
    <dataObject id="DataObject_0f0amhd" />
    <userTask id="Activity_0iwkjts" name="3. Revisión individual de artefactos por miembros" camunda:assignee="Miembros_OGA">
      <documentation>Cada miembro del OGA revisa de forma individual los artefactos recibidos evaluando: (1) alineación con el plan estratégico institucional, (2) completitud y coherencia del DOA-v1, (3) suficiencia del contexto documentado en DCA-v1, (4) cobertura del mapa de stakeholders SMP-v1, (5) trazabilidad de la matriz MTA-v1.</documentation>
      <incoming>Flow_0fcwfiz</incoming>
      <outgoing>Flow_0rz7vg9</outgoing>
      <property id="Property_1q6qylv" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_0rhjuco">
        <sourceRef>DataObjectReference_1nxneyy</sourceRef>
        <targetRef>Property_1q6qylv</targetRef>
      </dataInputAssociation>
    </userTask>
    <userTask id="Activity_07f19pr" name="4. Sesión formal de deliberación y votación" camunda:assignee="Miembros_OGA">
      <documentation>El OGA se reúne formalmente. Los miembros exponen sus observaciones, se debate y se alcanza una decisión por votación o consenso: (A) Aprobado sin condiciones, (B) Aprobado con observaciones menores (el AEP las incorpora sin nueva revisión), (C) Requiere ajustes sustanciales y nueva revisión.</documentation>
      <incoming>Flow_0rz7vg9</incoming>
      <outgoing>Flow_1i1n136</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_17ie309" name="¿Aprueba los artefactos?">
      <incoming>Flow_1i1n136</incoming>
      <outgoing>Flow_1j7g6ji</outgoing>
      <outgoing>Flow_1hpy63l</outgoing>
    </exclusiveGateway>
    <userTask id="Activity_0b1p9ep" name="1. Recepción y registro de artefactos" camunda:assignee="Secretaria_OGA">
      <documentation>La coordinación del OGA acusa recibo del paquete enviado por el AEP (DOA-v1, DCA-v1, SMP-v1, MTA-v1), lo registra en la bitácora de revisiones y distribuye a los miembros del comité.</documentation>
      <incoming>Flow_0i7zpzt</incoming>
      <outgoing>Flow_1lrgpjx</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0ho874j">
        <targetRef>DataObjectReference_1nxneyy</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="Activity_1wdvm5s" name="2. Convocatoria y agenda de sesión de revisión" camunda:assignee="Secretaria_OGA">
      <documentation>Se convoca la sesión formal del OGA, se establece la agenda de revisión y se confirma quórum. Plazo típico: 5 días hábiles desde la recepción.</documentation>
      <incoming>Flow_1lrgpjx</incoming>
      <outgoing>Flow_0fcwfiz</outgoing>
    </userTask>
    <userTask id="Activity_0kvav8n" name="5. Emisión del acta de aprobación y notificación al AEP" camunda:assignee="Secretaria_OGA">
      <documentation>El OGA emite el acta formal de aprobación (DOA-v1.0), la firma y notifica al AEP. La Línea Base F1 queda autorizada para publicación en el repositorio corporativo.</documentation>
      <incoming>Flow_1j7g6ji</incoming>
      <outgoing>Flow_0q5y7aa</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_00w6fh4">
        <targetRef>DataObjectReference_1bkoiru</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="Activity_1qvvdo6" name="6. Documentación de observaciones y envío al AEP" camunda:assignee="Secretaria_OGA">
      <documentation>El OGA documenta formalmente las observaciones y las envía al AEP con un plazo de respuesta. Cada observación indica el artefacto afectado, el criterio incumplido y la acción correctiva requerida.</documentation>
      <incoming>Flow_1hpy63l</incoming>
      <outgoing>Flow_0hod7mh</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_1k48vai">
        <targetRef>DataObjectReference_1bkoiru</targetRef>
      </dataOutputAssociation>
    </userTask>
    <dataObjectReference id="DataObjectReference_1bkoiru" name="Acta de decisión  emitida por el OGA" dataObjectRef="DataObject_0d9sg1t" />
    <dataObject id="DataObject_0d9sg1t" />
    <parallelGateway id="Gateway_0nan39s" name="7. Consolida los resultados">
      <incoming>Flow_0q5y7aa</incoming>
      <incoming>Flow_0hod7mh</incoming>
      <outgoing>Flow_1p2ltcq</outgoing>
    </parallelGateway>
    <endEvent id="Event_0eupdqb" name="Decisión notificada al AEP">
      <incoming>Flow_1p2ltcq</incoming>
      <property id="Property_1hhsfem" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_0i9tl72">
        <sourceRef>DataObjectReference_0z7loav</sourceRef>
        <targetRef>Property_1hhsfem</targetRef>
      </dataInputAssociation>
      <messageEventDefinition id="MessageEventDefinition_1vf46zg" />
    </endEvent>
    <dataObjectReference id="DataObjectReference_0z7loav" name="LBA-F1 actualizado" dataObjectRef="DataObject_096dams" />
    <dataObject id="DataObject_096dams" />
    <sequenceFlow id="Flow_0i7zpzt" sourceRef="Event_0f3xrhd" targetRef="Activity_0b1p9ep" />
    <sequenceFlow id="Flow_0fcwfiz" sourceRef="Activity_1wdvm5s" targetRef="Activity_0iwkjts" />
    <sequenceFlow id="Flow_0rz7vg9" sourceRef="Activity_0iwkjts" targetRef="Activity_07f19pr" />
    <sequenceFlow id="Flow_1i1n136" sourceRef="Activity_07f19pr" targetRef="Gateway_17ie309" />
    <sequenceFlow id="Flow_1j7g6ji" name="si" sourceRef="Gateway_17ie309" targetRef="Activity_0kvav8n">
      <conditionExpression>Aprobado</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1hpy63l" name="no" sourceRef="Gateway_17ie309" targetRef="Activity_1qvvdo6">
      <conditionExpression>Requiere ajustes</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1lrgpjx" sourceRef="Activity_0b1p9ep" targetRef="Activity_1wdvm5s" />
    <sequenceFlow id="Flow_0q5y7aa" sourceRef="Activity_0kvav8n" targetRef="Gateway_0nan39s" />
    <sequenceFlow id="Flow_0hod7mh" sourceRef="Activity_1qvvdo6" targetRef="Gateway_0nan39s" />
    <sequenceFlow id="Flow_1p2ltcq" sourceRef="Gateway_0nan39s" targetRef="Event_0eupdqb" />
  </process>
