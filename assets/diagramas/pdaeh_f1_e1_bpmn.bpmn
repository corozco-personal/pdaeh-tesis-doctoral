  <collaboration id="Collab_F1">
    <participant id="Pool_F1" name="F1.E1: Objetivo de la arquitectura." processRef="Process_F1" />
  </collaboration>
  <process id="Process_F1" name="Proceso F1 — Definición Estratégica" isExecutable="true">
    <laneSet id="LaneSet_F1">
      <lane id="Lane_SE_GPA" name="SE / GPA: Stakeholder empresarial / gestor de portafolio">
        <flowNodeRef>Gateway_1wwcpkd</flowNodeRef>
        <flowNodeRef>Task_F1_SE_review_obj</flowNodeRef>
      </lane>
      <lane id="Lane_AEP" name="AEP. Arquitecto empresarial del proceso">
        <flowNodeRef>Task_F1_E1_A1</flowNodeRef>
        <flowNodeRef>Task_F1_E1_A2</flowNodeRef>
        <flowNodeRef>StartEvent_F1</flowNodeRef>
        <flowNodeRef>EndEvent_F1</flowNodeRef>
      </lane>
    </laneSet>
    <dataObject id="DO_LBA_F1" name="Línea Base F1" />
    <dataObjectReference id="DOR_LBA_F1" name="Línea Base F1" dataObjectRef="DO_LBA_F1" />
    <userTask id="Task_F1_E1_A1" name="F1.E1.A1 Análisis de objetivos estratégicos" camunda:assignee="AEP">
      <documentation>Entradas: Plan Estratégico, Catálogo iniciativas. Tareas: T1 Revisar plan, T2 Identificar iniciativas con componente cuántico, T3 Extraer y clasificar objetivos, T4 Priorizar (MoSCoW). Salida: LOE-v1.</documentation>
      <incoming>Flow_0z2lsdi</incoming>
      <incoming>SF_start_to_parallel</incoming>
      <outgoing>SF_E1A1_to_SE</outgoing>
      <property id="Property_1522knv" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_002">
        <sourceRef>DOR_PlanEstrategico</sourceRef>
        <targetRef>Property_1522knv</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DataInputAssociation_1hg2vmu">
        <sourceRef>DataObjectReference_0da45u2</sourceRef>
        <targetRef>Property_1522knv</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_004">
        <sourceRef>Task_F1_E1_A1</sourceRef>
        <targetRef>DOR_LOE</targetRef>
      </dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="Gateway_1wwcpkd" name="¿Los objetivos son aprobados?">
      <incoming>SF_SE_to_E1A2</incoming>
      <outgoing>Flow_0c8lmpx</outgoing>
      <outgoing>Flow_0z2lsdi</outgoing>
    </exclusiveGateway>
    <userTask id="Task_F1_SE_review_obj" name="F1.E1.A2: Validación de objetivos priorizados" camunda:assignee="SE">
      <documentation>Stakeholders validan priorización y alineación con intereses del negocio.</documentation>
      <incoming>SF_E1A1_to_SE</incoming>
      <outgoing>SF_SE_to_E1A2</outgoing>
      <property id="Property_1mwz0xx" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_001">
        <sourceRef>DOR_LOE</sourceRef>
        <targetRef>Property_1mwz0xx</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_1us3k1k">
        <targetRef>DataObjectReference_102y0q9</targetRef>
      </dataOutputAssociation>
    </userTask>
    <dataObjectReference id="DOR_LOE" name="DOE inicial" dataObjectRef="DO_LOE" />
    <dataObject id="DO_LOE" name="LOE-v1 Listado priorizado de objetivos" />
    <userTask id="Task_F1_E1_A2" name="F1.E1.A3 Formulación de objetivos arquitectónicos" camunda:assignee="AEP">
      <documentation>Entradas: LOE-v1 validado. Tareas: T1 Reformular objetivos (SMART), T2 Asignar indicadores, T3 Trazabilidad negocio-arquitectura, T4 Documentar supuestos. Salidas: DOA-v1, MTA-v1.</documentation>
      <incoming>Flow_0c8lmpx</incoming>
      <outgoing>Flow_05e9qeu</outgoing>
      <property id="Property_15ymtf7" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_1q6za4p">
        <sourceRef>DataObjectReference_102y0q9</sourceRef>
        <targetRef>Property_15ymtf7</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_007">
        <sourceRef>Task_F1_E1_A2</sourceRef>
        <targetRef>DOR_MTA</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_1x9n22n">
        <targetRef>DataObjectReference_02j9v16</targetRef>
      </dataOutputAssociation>
    </userTask>
    <dataObjectReference id="DOR_PlanEstrategico" name="Plan estratégico institucional" dataObjectRef="DO_PlanEstrategico" />
