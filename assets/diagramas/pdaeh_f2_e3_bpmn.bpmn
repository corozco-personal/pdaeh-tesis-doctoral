<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PDAEH-F2-v1" targetNamespace="http://pdaeh.org/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.1">
  <collaboration id="Collab_F2">
    <participant id="Pool_F2" name="F2.E3. Nivel de abstracción arquitectónica" processRef="Process_F2" />
  </collaboration>
  <process id="Process_F2" name="Proceso F2 — Fundamentación Conceptual" isExecutable="true">
    <laneSet id="LaneSet_F2">
      <lane id="Lane_SE_GPA_F2" name="Stakeholder empresarial (SE) / Gestor de portafolio (GPA)">
        <flowNodeRef>Task_F2_SE_abs</flowNodeRef>
        <flowNodeRef>Gateway_F2_abs_gw</flowNodeRef>
      </lane>
      <lane id="Lane_AEP_F2" name="Arquitecto empresarial del proceso (AEP)">
        <flowNodeRef>StartEvent_F2</flowNodeRef>
        <flowNodeRef>Task_F2_E3_A1</flowNodeRef>
        <flowNodeRef>Task_F2_E3_A3</flowNodeRef>
        <flowNodeRef>Event_1mfnma9</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_F2" name="Inicio">
      <documentation>
        Inicio de F2 — Fundamentación Conceptual.
        Precondición: Línea Base F1 aprobada por el OGA.
        Artefactos disponibles: DOA-v1, MTA-v1, DCA-v1, SMP-v1.
      </documentation>
      <outgoing>SF_F2_start_par</outgoing>
    </startEvent>
    <dataObjectReference id="DOR_DPV" name="DPV inicial" dataObjectRef="DO_DPV" />
    <dataObject id="DO_DPV" name="DPV-v1" />
    <userTask id="Task_F2_SE_abs" name="F2.E3.A2 Validación de perspectivas y niveles de abstracción" camunda:assignee="SE">
      <documentation>
        Entrada: DPV-v1.
        Los stakeholders (SE/GPA) revisan el DPV-v1 evaluando:
          (1) Suficiencia de las perspectivas para comunicar la arquitectura
              a distintas audiencias organizacionales.
          (2) Adecuación de los niveles de abstracción a los objetivos
              estratégicos del DOA-v1.
          (3) Correspondencia entre las vistas definidas y las preocupaciones
              documentadas en SMP-v1.
          (4) Claridad y comprensibilidad de los criterios de uso de cada vista.
        Resultado: autorización para formalizar (F2.E3.A3) o devolución al
        AEP con observaciones para revisión.
      </documentation>
      <incoming>SF_F2_E3A1_SE</incoming>
      <outgoing>SF_F2_SE_abs_gw</outgoing>
      <property id="Prop_SE_abs" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_SE_abs_DPV">
        <sourceRef>DOR_DPV</sourceRef>
        <targetRef>Prop_SE_abs</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_1o96wap">
        <targetRef>DataObjectReference_0fi2i31</targetRef>
      </dataOutputAssociation>
    </userTask>
    <dataObjectReference id="DOR_DOA_F1" name="DOA" dataObjectRef="DO_DOA_F1" />
    <dataObject id="DO_DOA_F1" name="DOA-v1" />
    <dataObjectReference id="DOR_MTA_F1" name="MTA" dataObjectRef="DO_MTA_F1" />
    <dataObject id="DO_MTA_F1" name="MTA-v1" />
    <userTask id="Task_F2_E3_A1" name="F2.E3.A1 Definición de perspectivas y vistas arquitectónicas" camunda:assignee="AEP">
      <documentation>
        Entradas: DOA-v1, MTA-v1.
        Tareas:
          T1 Identificar perspectivas arquitectónicas relevantes para el modelo
             híbrido clásico-cuántico (negocio, datos, aplicación, tecnología,
             integración cuántica).
          T2 Definir las vistas arquitectónicas asociadas a cada perspectiva
             y delimitar su alcance y audiencia.
          T3 Establecer los niveles de abstracción requeridos por vista,
             diferenciando entre nivel conceptual, lógico y físico.
          T4 Verificar la cobertura de las perspectivas respecto a los objetivos
             arquitectónicos del DOA-v1.
          T5 Documentar el inventario de perspectivas, vistas y niveles en DPV-v1.
        Salida: DPV-v1 (Documento de Perspectivas y Vistas).
      </documentation>
      <incoming>SF_F2_abs_no</incoming>
      <incoming>SF_F2_start_par</incoming>
      <outgoing>SF_F2_E3A1_SE</outgoing>
      <property id="Prop_E3A1" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_E3A1_DOA">
        <sourceRef>DOR_DOA_F1</sourceRef>
        <targetRef>Prop_E3A1</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_E3A1_MTA">
        <sourceRef>DOR_MTA_F1</sourceRef>
        <targetRef>Prop_E3A1</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_E3A1_DPV">
        <sourceRef>Task_F2_E3_A1</sourceRef>
        <targetRef>DOR_DPV</targetRef>
      </dataOutputAssociation>
    </userTask>
    <dataObjectReference id="DataObjectReference_0fi2i31" name="DPV actualizado" dataObjectRef="DataObject_0c16uea" />
    <dataObject id="DataObject_0c16uea" />
    <sequenceFlow id="SF_F2_start_par" sourceRef="StartEvent_F2" targetRef="Task_F2_E3_A1" />
    <sequenceFlow id="SF_F2_abs_yes" name="sí" sourceRef="Gateway_F2_abs_gw" targetRef="Task_F2_E3_A3">
      <conditionExpression>Perspectivas aprobadas</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SF_F2_E3A1_SE" sourceRef="Task_F2_E3_A1" targetRef="Task_F2_SE_abs" />
    <sequenceFlow id="SF_F2_SE_abs_gw" sourceRef="Task_F2_SE_abs" targetRef="Gateway_F2_abs_gw" />
    <sequenceFlow id="SF_F2_abs_no" name="no" sourceRef="Gateway_F2_abs_gw" targetRef="Task_F2_E3_A1">
      <conditionExpression>Requiere ajustes</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="Gateway_F2_abs_gw" name="¿Las perspectivas y niveles de abstracción son aprobados?">
      <incoming>SF_F2_SE_abs_gw</incoming>
      <outgoing>SF_F2_abs_yes</outgoing>
      <outgoing>SF_F2_abs_no</outgoing>
    </exclusiveGateway>
    <userTask id="Task_F2_E3_A3" name="F2.E3.A3 Formalización del modelo de abstracción arquitectónica" camunda:assignee="AEP">
      <documentation>
        Entradas: DPV-v1 validado, MTA-v1.
        Tareas:
          T1 Redactar la descripción formal de cada nivel de abstracción
             (propósito, criterios de aplicación, relación con otras vistas)
             y documentar en DNA-v1.
          T2 Establecer correspondencias explícitas entre las vistas del
             DNA-v1 y los objetivos arquitectónicos del DOA-v1.
          T3 Actualizar la Matriz de Trazabilidad a MTA-v2 incorporando
             los vínculos entre perspectivas, vistas y objetivos.
          T4 Validar la consistencia interna del modelo de abstracción
             (sin solapamientos, sin vacíos de cobertura).
        Salidas: DNA-v1 (Documento de Niveles de Abstracción), MTA-v2.
      </documentation>
      <incoming>SF_F2_abs_yes</incoming>
      <outgoing>Flow_1cbm5it</outgoing>
      <property id="Prop_E3A3" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_E3A3_MTA1">
        <sourceRef>DOR_MTA_F1</sourceRef>
        <targetRef>Prop_E3A3</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DataInputAssociation_0jd39z2">
        <sourceRef>DataObjectReference_0fi2i31</sourceRef>
        <targetRef>Prop_E3A3</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_E3A3_DNA">
        <sourceRef>Task_F2_E3_A3</sourceRef>
        <targetRef>DOR_DNA</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation id="DOA_E3A3_MTA2">
        <sourceRef>Task_F2_E3_A3</sourceRef>
        <targetRef>DOR_MTA_F2</targetRef>
      </dataOutputAssociation>
    </userTask>
    <endEvent id="Event_1mfnma9" name="Fin">
      <documentation>
        Línea Base F2 aprobada por el OGA.
        Artefactos publicados: DNA-v1, DVA-v1, MTA-v2.
        La fase F3 — Especificación de Calidad puede iniciarse.
      </documentation>
      <incoming>Flow_1cbm5it</incoming>
      <property id="Property_1muyuom" name="__targetRef_placeholder" />
    </endEvent>
    <dataObjectReference id="DOR_MTA_F2" name="MTA actualizado" dataObjectRef="DO_MTA_F2" />
    <dataObject id="DO_MTA_F2" name="MTA-v2" />
    <sequenceFlow id="Flow_1cbm5it" sourceRef="Task_F2_E3_A3" targetRef="Event_1mfnma9" />
    <dataObjectReference id="DOR_DNA" name="DNA" dataObjectRef="DO_DNA" />
    <dataObject id="DO_DNA" name="DNA-v1" />
  </process>
