<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PDAEH-F2-v1" targetNamespace="http://pdaeh.org/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.1">
  <collaboration id="Collab_F2">
    <participant id="Pool_F2" name="F2.E4. Vocabulario arquitectónico" processRef="Process_F2" />
  </collaboration>
  <process id="Process_F2" name="Proceso F2 — Fundamentación Conceptual" isExecutable="true">
    <laneSet id="LaneSet_F2">
      <lane id="Lane_SE_GPA_F2" name="Stakeholder empresarial (SE) / Gestor de portafolio (GPA)">
        <flowNodeRef>Task_F2_SE_vocab</flowNodeRef>
        <flowNodeRef>Gateway_F2_vocab_gw</flowNodeRef>
        <flowNodeRef>Event_18qz6ti</flowNodeRef>
      </lane>
      <lane id="Lane_AEP_F2" name="Arquitecto empresarial del proceso (AEP)">
        <flowNodeRef>Task_F2_E4_A1</flowNodeRef>
        <flowNodeRef>StartEvent_F2</flowNodeRef>
        <flowNodeRef>Task_F2_E4_A2</flowNodeRef>
      </lane>
    </laneSet>
    <userTask id="Task_F2_E4_A1" name="F2.E4.A1 Recopilación de análisis terminológico" camunda:assignee="AEP">
      <documentation>
        Entradas: DOA-v1, DCA-v1, SMP-v1.
        Tareas:
          T1 Extraer términos clave presentes en los artefactos de F1
             (DOA-v1, DCA-v1, SMP-v1) y en la base conceptual del modelo.
          T2 Identificar términos especializados del dominio cuántico, híbrido
             y de arquitectura empresarial relevantes para el proceso.
          T3 Detectar ambigüedades, sinónimos y términos con definiciones
             inconsistentes entre fuentes.
          T4 Clasificar los términos por categoría semántica: negocio,
             tecnológico-clásico, tecnológico-cuántico, organizacional,
             normativo/estándar.
        Salida: ITA-v1 (Inventario de Términos Arquitectónicos).
      </documentation>
      <incoming>SF_F2_start_par</incoming>
      <outgoing>SF_F2_E4A1_E4A2</outgoing>
      <property id="Prop_E4A1" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_E4A1_DCA">
        <sourceRef>DOR_DCA_SMP</sourceRef>
        <targetRef>Prop_E4A1</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_E4A1_DOA">
        <sourceRef>DOR_DOA_F1</sourceRef>
        <targetRef>Prop_E4A1</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_E4A1_ITA">
        <sourceRef>Task_F2_E4_A1</sourceRef>
        <targetRef>DOR_ITA</targetRef>
      </dataOutputAssociation>
    </userTask>
    <dataObjectReference id="DOR_DCA_SMP" name="DCA" dataObjectRef="DO_DCA_SMP" />
    <dataObject id="DO_DCA_SMP" name="DCA-v1 / SMP-v1" />
    <dataObjectReference id="DOR_DOA_F1" name="DOA" dataObjectRef="DO_DOA_F1" />
    <dataObject id="DO_DOA_F1" name="DOA-v1" />
    <dataObjectReference id="DOR_ITA" name="ITA" dataObjectRef="DO_ITA" />
    <dataObject id="DO_ITA" name="ITA-v1" />
    <startEvent id="StartEvent_F2" name="Inicio">
      <documentation>
        Inicio de F2 — Fundamentación Conceptual.
        Precondición: Línea Base F1 aprobada por el OGA.
        Artefactos disponibles: DOA-v1, MTA-v1, DCA-v1, SMP-v1.
      </documentation>
      <outgoing>SF_F2_start_par</outgoing>
    </startEvent>
    <userTask id="Task_F2_E4_A2" name="F2.E4.A2 Construcción del vocabulario arquitectónico unificado" camunda:assignee="AEP">
      <documentation>
        Entrada: ITA-v1.
        Tareas:
          T1 Redactar definiciones precisas para cada término, asegurando
             coherencia con ISO/IEC/IEEE 42010:2022, TOGAF y vocabulario
             cuántico emergente.
          T2 Establecer relaciones semánticas entre términos (sinonimia,
             hiponimia, dependencia conceptual, equivalencia clásico-cuántica).
          T3 Incorporar ejemplos de uso contextualizado en arquitecturas
             híbridas clásico-cuánticas para cada término relevante.
          T4 Incluir referencias cruzadas a los artefactos de F1 y F2 donde
             cada término es utilizado.
          T5 Documentar el vocabulario consolidado en DVA-v1.
        Salida: DVA-v1 (Diccionario de Vocabulario Arquitectónico, borrador).
      </documentation>
      <incoming>SF_F2_E4A1_E4A2</incoming>
      <incoming>SF_F2_vocab_no</incoming>
      <outgoing>SF_F2_E4A2_SE</outgoing>
      <property id="Prop_E4A2" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_E4A2_ITA">
        <sourceRef>DOR_ITA</sourceRef>
        <targetRef>Prop_E4A2</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_E4A2_DVA">
        <sourceRef>Task_F2_E4_A2</sourceRef>
        <targetRef>DOR_DVA</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="Task_F2_SE_vocab" name="F2.E4.A3 Validación del vocabulario arquitectónico" camunda:assignee="SE">
      <documentation>
        Entrada: DVA-v1 (borrador).
        Los stakeholders (SE/GPA) revisan el DVA-v1 evaluando:
          (1) Comprensibilidad de las definiciones para audiencias no técnicas.
          (2) Alineación del vocabulario con la terminología de negocio
              establecida en la organización.
          (3) Adecuación de los términos cuánticos para su uso en
              documentación arquitectónica empresarial.
          (4) Ausencia de ambigüedades o definiciones contradictorias.
          (5) Suficiencia de los ejemplos de uso aportados.
        Resultado: autorización para continuar (join → envío OGA) o
        devolución al AEP para revisión del DVA-v1.
      </documentation>
      <incoming>SF_F2_E4A2_SE</incoming>
      <outgoing>SF_F2_SE_vocab_gw</outgoing>
      <property id="Prop_SE_vocab" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_SE_vocab_DVA">
        <sourceRef>DOR_DVA</sourceRef>
        <targetRef>Prop_SE_vocab</targetRef>
      </dataInputAssociation>
    </userTask>
    <exclusiveGateway id="Gateway_F2_vocab_gw" name="¿El vocabulario arquitectónico es aprobado?">
      <incoming>SF_F2_SE_vocab_gw</incoming>
      <outgoing>SF_F2_vocab_no</outgoing>
      <outgoing>Flow_1gnyqod</outgoing>
    </exclusiveGateway>
    <endEvent id="Event_18qz6ti" name="Fin">
      <documentation>
        Línea Base F2 aprobada por el OGA.
        Artefactos publicados: DNA-v1, DVA-v1, MTA-v2.
        La fase F3 — Especificación de Calidad puede iniciarse.
      </documentation>
      <incoming>Flow_1gnyqod</incoming>
      <property id="Property_0ye14a4" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_0okv9gm">
        <sourceRef>DataObjectReference_152mtsf</sourceRef>
        <targetRef>Property_0ye14a4</targetRef>
      </dataInputAssociation>
    </endEvent>
    <dataObjectReference id="DOR_DVA" name="DVA inicial" dataObjectRef="DO_DVA" />
    <dataObject id="DO_DVA" name="DVA-v1" />
    <sequenceFlow id="SF_F2_start_par" sourceRef="StartEvent_F2" targetRef="Task_F2_E4_A1" />
    <sequenceFlow id="SF_F2_E4A1_E4A2" sourceRef="Task_F2_E4_A1" targetRef="Task_F2_E4_A2" />
    <sequenceFlow id="SF_F2_vocab_no" name="no" sourceRef="Gateway_F2_vocab_gw" targetRef="Task_F2_E4_A2">
      <conditionExpression>Requiere ajustes</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SF_F2_E4A2_SE" sourceRef="Task_F2_E4_A2" targetRef="Task_F2_SE_vocab" />
    <sequenceFlow id="SF_F2_SE_vocab_gw" sourceRef="Task_F2_SE_vocab" targetRef="Gateway_F2_vocab_gw" />
    <sequenceFlow id="Flow_1gnyqod" name="si" sourceRef="Gateway_F2_vocab_gw" targetRef="Event_18qz6ti" />
    <dataObjectReference id="DataObjectReference_152mtsf" name="DVA" dataObjectRef="DataObject_0icb19d" />
    <dataObject id="DataObject_0icb19d" />
  </process>
