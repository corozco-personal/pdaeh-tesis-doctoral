<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PDAEH-F3-general-v2" targetNamespace="http://pdaeh.org/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.1">
  <collaboration id="Collab_F3">
    <participant id="Pool_F3" name="F3 — Configuración Estructural (E6 → E5)" processRef="Process_F3" />
    <participant id="Pool_OGA_F2" name="Órgano de Gobierno Arquitectónico (OGA)" processRef="Process_OGA_F2" />
    <messageFlow id="Flow_14s7pxe" sourceRef="Event_0eupdqb" targetRef="Task_F3_adjust" />
  </collaboration>
  <process id="Process_F3" name="Proceso F3 — Configuración Estructural" isExecutable="false">
    <laneSet id="LaneSet_F3">
      <lane id="Lane_AEP_F3" name="Arquitecto empresarial del proceso (AEP) /                         Arquitectos Especialistas (ASP / AIP / ADP / ASecP / ETC)">
        <flowNodeRef>StartEvent_F3</flowNodeRef>
        <flowNodeRef>CA_F3_E6</flowNodeRef>
        <flowNodeRef>CA_F3_E5</flowNodeRef>
        <flowNodeRef>Task_F3_send</flowNodeRef>
        <flowNodeRef>Task_F3_adjust</flowNodeRef>
        <flowNodeRef>Gateway_F3_approval</flowNodeRef>
        <flowNodeRef>EndEvent_F3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_F3" name="Inicio F3">
      <documentation>
        Inicio de F3 — Configuración Estructural.
        Precondición: Línea Base F2 aprobada por el OGA.
        Artefactos disponibles: DNA-v1, DVA-v1, MTA-v2, DOA-v1.
        Flujo: E6 (Atributos de calidad) → E5 (Estructuras arquitectónicas).
      </documentation>
      <outgoing>SF_F3_start_E6</outgoing>
    </startEvent>
    <callActivity id="CA_F3_E6" name="F3.E6. Atributos de calidad" calledElement="Process_F3_E6">
      <documentation>
        Subproceso E6. Detalle en PDAEH_f3_E6_bpmn.xml.
        Roles: AEP, ASP, AIP/ADP, ASecP/ETC, SE/GPA.
        Entradas: DNA-v1, DVA-v1, DOA-v1.
        Salidas: IAQ-v1 (rendimiento, escalabilidad, mantenibilidad, facilidad de pruebas,
          interoperabilidad, capacidad de integración, calidad de datos, seguridad,
          resiliencia post-cuántica), MAQ-v1, MTA-v3.
      </documentation>
      <incoming>SF_F3_start_E6</incoming>
      <outgoing>SF_F3_E6_E5</outgoing>
      <property id="Prop_CA_E6" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_CA_E6_DNA">
        <sourceRef>DOR_DNA_F3</sourceRef>
        <targetRef>Prop_CA_E6</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_CA_E6_IAQ">
        <sourceRef>CA_F3_E6</sourceRef>
        <targetRef>DOR_IAQ</targetRef>
      </dataOutputAssociation>
    </callActivity>
    <callActivity id="CA_F3_E5" name="F3.E5. Estructuras arquitectónicas" calledElement="Process_F3_E5">
      <documentation>
        Subproceso E5. Detalle en PDAEH_f3_E5_bpmn.xml.
        Roles: AEP, ASP, AIP/ADP, ASecP/ETC, SE/GPA.
        Entradas: IAQ-v1, MAQ-v1, DNA-v1, MTA-v3.
        Salidas: DEA-v1 (estructuras de solución, integración, datos,
          seguridad y cuánticas; patrones de escalabilidad, mantenibilidad,
          facilidad de pruebas y capacidad de integración), MTA-v4.
      </documentation>
      <incoming>SF_F3_E6_E5</incoming>
      <outgoing>SF_F3_E5_send</outgoing>
      <property id="Prop_CA_E5" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_CA_E5_IAQ">
        <sourceRef>DOR_IAQ</sourceRef>
        <targetRef>Prop_CA_E5</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DataInputAssociation_0l9w4sv">
        <sourceRef>DOR_DNA_F3</sourceRef>
        <targetRef>Prop_CA_E5</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_1gli698">
        <targetRef>DataObjectReference_17j4ewu</targetRef>
      </dataOutputAssociation>
    </callActivity>
    <sendTask id="Task_F3_send" name="F3.E6.A6 {E5} Preparación y envío de artefactos al OGA" camunda:type="external" camunda:topic="OGA_Review_F3">
      <documentation>
        El AEP consolida IAQ-v1, MAQ-v1, DEA-v1 y MTA-v4 en la LBA-F3 y envía al OGA.
      </documentation>
      <incoming>SF_F3_E5_send</incoming>
      <incoming>SF_F3_no_resend</incoming>
      <outgoing>SF_F3_send_adjust</outgoing>
      <property id="Prop_send_F3" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_send_IAQ">
        <sourceRef>DOR_IAQ</sourceRef>
        <targetRef>Prop_send_F3</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_send_MAQ">
        <targetRef>Prop_send_F3</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_send_DEA">
        <targetRef>Prop_send_F3</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_send_MTA4">
        <targetRef>Prop_send_F3</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DataInputAssociation_054dn0z">
        <sourceRef>DataObjectReference_17j4ewu</sourceRef>
        <targetRef>Prop_send_F3</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DataInputAssociation_1xe44j1">
        <sourceRef>DOR_IAQ</sourceRef>
        <targetRef>Prop_send_F3</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_send_LBA_F3i">
        <sourceRef>Task_F3_send</sourceRef>
        <targetRef>DOR_LBA_F3i</targetRef>
      </dataOutputAssociation>
    </sendTask>
    <userTask id="Task_F3_adjust" name="F3.E6.A7 {E5} Ajustar artefactos según observaciones del OGA" camunda:assignee="AEP">
      <documentation>
        El AEP incorpora observaciones del OGA sobre IAQ-v1, MAQ-v1 y/o DEA-v1 según aplique.
      </documentation>
      <incoming>SF_F3_send_adjust</incoming>
      <outgoing>SF_F3_adjust_gw</outgoing>
      <property id="Prop_adjust_F3" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_adjust_LBA_F3i">
        <sourceRef>DOR_LBA_F3i</sourceRef>
        <targetRef>Prop_adjust_F3</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_adjust_LBA_F3a">
        <sourceRef>Task_F3_adjust</sourceRef>
        <targetRef>DOR_LBA_F3a</targetRef>
      </dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="Gateway_F3_approval" name="¿OGA aprueba los artefactos?">
      <incoming>SF_F3_adjust_gw</incoming>
      <outgoing>SF_F3_approval_yes</outgoing>
      <outgoing>SF_F3_no_resend</outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_F3" name="Fin">
      <documentation>
        Fin de F3. LBA-F3 aprobada. Artefactos: IAQ-v1, MAQ-v1, DEA-v1, MTA-v4.
        F4 — Materialización arquitectónica puede iniciarse.
      </documentation>
      <incoming>SF_F3_approval_yes</incoming>
    </endEvent>
    <dataObjectReference id="DOR_DNA_F3" name="LBA-F2" dataObjectRef="DO_DNA_F3" />
    <dataObject id="DO_DNA_F3" name="DNA-v1 (desde F2.E3)" />
    <dataObjectReference id="DOR_IAQ" name="DAC" dataObjectRef="DO_IAQ" />
    <dataObject id="DO_IAQ" name="IAQ-v1 (Inventario de Atributos de Calidad)" />
    <dataObjectReference id="DataObjectReference_17j4ewu" name="DEA" dataObjectRef="DataObject_0ufma1n" />
    <dataObject id="DataObject_0ufma1n" />
    <sequenceFlow id="SF_F3_start_E6" sourceRef="StartEvent_F3" targetRef="CA_F3_E6" />
    <sequenceFlow id="SF_F3_E6_E5" sourceRef="CA_F3_E6" targetRef="CA_F3_E5" />
    <sequenceFlow id="SF_F3_E5_send" sourceRef="CA_F3_E5" targetRef="Task_F3_send" />
    <sequenceFlow id="SF_F3_no_resend" name="no" sourceRef="Gateway_F3_approval" targetRef="Task_F3_send">
      <conditionExpression>Requiere ajustes y reenvío</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SF_F3_send_adjust" name="La transición ocurre cuando se recibe la respuesta del OGA" sourceRef="Task_F3_send" targetRef="Task_F3_adjust" />
    <sequenceFlow id="SF_F3_adjust_gw" sourceRef="Task_F3_adjust" targetRef="Gateway_F3_approval" />
    <sequenceFlow id="SF_F3_approval_yes" name="Sí" sourceRef="Gateway_F3_approval" targetRef="EndEvent_F3">
      <conditionExpression>OGA aprueba LBA-F3</conditionExpression>
    </sequenceFlow>
    <dataObjectReference id="DOR_LBA_F3a" name="LBA-F3 aprobado" dataObjectRef="DO_LBA_F3a" />
    <dataObject id="DO_LBA_F3a" name="LBA-F3 aprobada" />
    <dataObjectReference id="DOR_LBA_F3i" name="LBA-F3&#10;inicial" dataObjectRef="DO_LBA_F3i" />
    <dataObject id="DO_LBA_F3i" name="LBA-F3 inicial" />
  </process>
  <process id="Process_OGA_F2" name="Proceso OGA — Revisión F2" isExecutable="false">
    <laneSet id="LaneSet_19burgr">
      <lane id="Lane_OGA_F2" name="OGA — Órgano de Gobierno Arquitectónico">
        <flowNodeRef>Activity_0iwkjts</flowNodeRef>
        <flowNodeRef>Activity_07f19pr</flowNodeRef>
        <flowNodeRef>Gateway_17ie309</flowNodeRef>
        <flowNodeRef>Event_0f3xrhd</flowNodeRef>
        <flowNodeRef>Activity_0b1p9ep</flowNodeRef>
        <flowNodeRef>Activity_1wdvm5s</flowNodeRef>
        <flowNodeRef>Activity_0kvav8n</flowNodeRef>
        <flowNodeRef>Event_0eupdqb</flowNodeRef>
        <flowNodeRef>Activity_1qvvdo6</flowNodeRef>
        <flowNodeRef>Gateway_0nan39s</flowNodeRef>
      </lane>
    </laneSet>
    <dataObjectReference id="DataObjectReference_1nxneyy" name="LBA-F3 inicial" dataObjectRef="DataObject_0sz0tsl" />
    <dataObject id="DataObject_0sz0tsl" />
    <userTask id="Activity_0iwkjts" name="3. Revisión individual de artefactos por miembros" camunda:assignee="Miembros_OGA">
      <documentation>Cada miembro del OGA revisa de forma individual los artefactos recibidos evaluando: (1) alineación con el plan estratégico institucional, (2) completitud y coherencia del DOA-v1, (3) suficiencia del contexto documentado en DCA-v1, (4) cobertura del mapa de stakeholders SMP-v1, (5) trazabilidad de la matriz MTA-v1.</documentation>
      <incoming>Flow_0fcwfiz</incoming>
      <outgoing>Flow_0rz7vg9</outgoing>
      <property id="Property_0sje3tz" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_0rhjuco">
        <sourceRef>DataObjectReference_1nxneyy</sourceRef>
        <targetRef>Property_0sje3tz</targetRef>
      </dataInputAssociation>
    </userTask>
    <userTask id="Activity_07f19pr" name="4. Sesión formal de deliberación y votación" camunda:assignee="Miembros_OGA">
      <documentation>El OGA se reúne formalmente. Los miembros exponen sus observaciones, se debate y se alcanza una decisión por votación o consenso: (A) Aprobado sin condiciones, (B) Aprobado con observaciones menores (el AEP las incorpora sin nueva revisión), (C) Requiere ajustes sustanciales y nueva revisión.</documentation>
      <incoming>Flow_0rz7vg9</incoming>
      <outgoing>Flow_1i1n136</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_17ie309" name="¿Aprueba los artefactos?">
      <incoming>Flow_1i1n136</incoming>
      <outgoing>Flow_1j7g6ji</outgoing>
      <outgoing>Flow_1hpy63l</outgoing>
    </exclusiveGateway>
    <startEvent id="Event_0f3xrhd" name="Recepción de artefactos">
      <outgoing>Flow_0i7zpzt</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0oulnjy" />
    </startEvent>
    <userTask id="Activity_0b1p9ep" name="1. Recepción y registro de artefactos" camunda:assignee="Secretaria_OGA">
      <documentation>La coordinación del OGA acusa recibo del paquete enviado por el AEP (DOA-v1, DCA-v1, SMP-v1, MTA-v1), lo registra en la bitácora de revisiones y distribuye a los miembros del comité.</documentation>
      <incoming>Flow_0i7zpzt</incoming>
      <outgoing>Flow_1lrgpjx</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0ho874j">
        <targetRef>DataObjectReference_1nxneyy</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="Activity_1wdvm5s" name="2. Convocatoria y agenda de sesión de revisión" camunda:assignee="Secretaria_OGA">
      <documentation>Se convoca la sesión formal del OGA, se establece la agenda de revisión y se confirma quórum. Plazo típico: 5 días hábiles desde la recepción.</documentation>
      <incoming>Flow_1lrgpjx</incoming>
      <outgoing>Flow_0fcwfiz</outgoing>
    </userTask>
    <userTask id="Activity_0kvav8n" name="5. Emisión del acta de aprobación y notificación al AEP" camunda:assignee="Secretaria_OGA">
      <documentation>El OGA emite el acta formal de aprobación (DOA-v1.0), la firma y notifica al AEP. La Línea Base F1 queda autorizada para publicación en el repositorio corporativo.</documentation>
      <incoming>Flow_1j7g6ji</incoming>
      <outgoing>Flow_0q5y7aa</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_00w6fh4">
        <targetRef>DataObjectReference_1bkoiru</targetRef>
      </dataOutputAssociation>
    </userTask>
    <endEvent id="Event_0eupdqb" name="Decisión notificada al AEP">
      <incoming>Flow_1p2ltcq</incoming>
      <property id="Property_0zefsgy" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_0i9tl72">
        <sourceRef>DataObjectReference_0z7loav</sourceRef>
        <targetRef>Property_0zefsgy</targetRef>
      </dataInputAssociation>
      <messageEventDefinition id="MessageEventDefinition_1wn247o" />
    </endEvent>
    <userTask id="Activity_1qvvdo6" name="6. Documentación de observaciones y envío al AEP" camunda:assignee="Secretaria_OGA">
      <documentation>El OGA documenta formalmente las observaciones y las envía al AEP con un plazo de respuesta. Cada observación indica el artefacto afectado, el criterio incumplido y la acción correctiva requerida.</documentation>
      <incoming>Flow_1hpy63l</incoming>
      <outgoing>Flow_0hod7mh</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_1k48vai">
        <targetRef>DataObjectReference_1bkoiru</targetRef>
      </dataOutputAssociation>
    </userTask>
    <parallelGateway id="Gateway_0nan39s" name="7. Consolida los resultados">
      <incoming>Flow_0q5y7aa</incoming>
      <incoming>Flow_0hod7mh</incoming>
      <outgoing>Flow_1p2ltcq</outgoing>
    </parallelGateway>
    <dataObjectReference id="DataObjectReference_1bkoiru" name="Acta de decisión  emitida por el OGA" dataObjectRef="DataObject_1uex3rs" />
    <dataObject id="DataObject_1uex3rs" />
    <dataObjectReference id="DataObjectReference_0z7loav" name="LBA-F3 actualizado" dataObjectRef="DataObject_0avk1lp" />
    <dataObject id="DataObject_0avk1lp" />
    <sequenceFlow id="Flow_0fcwfiz" sourceRef="Activity_1wdvm5s" targetRef="Activity_0iwkjts" />
    <sequenceFlow id="Flow_0rz7vg9" sourceRef="Activity_0iwkjts" targetRef="Activity_07f19pr" />
    <sequenceFlow id="Flow_1i1n136" sourceRef="Activity_07f19pr" targetRef="Gateway_17ie309" />
    <sequenceFlow id="Flow_1j7g6ji" name="si" sourceRef="Gateway_17ie309" targetRef="Activity_0kvav8n">
      <conditionExpression>Aprobado</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1hpy63l" name="no" sourceRef="Gateway_17ie309" targetRef="Activity_1qvvdo6">
      <conditionExpression>Requiere ajustes</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_0i7zpzt" sourceRef="Event_0f3xrhd" targetRef="Activity_0b1p9ep" />
    <sequenceFlow id="Flow_1lrgpjx" sourceRef="Activity_0b1p9ep" targetRef="Activity_1wdvm5s" />
    <sequenceFlow id="Flow_0q5y7aa" sourceRef="Activity_0kvav8n" targetRef="Gateway_0nan39s" />
    <sequenceFlow id="Flow_1p2ltcq" sourceRef="Gateway_0nan39s" targetRef="Event_0eupdqb" />
    <sequenceFlow id="Flow_0hod7mh" sourceRef="Activity_1qvvdo6" targetRef="Gateway_0nan39s" />
  </process>
