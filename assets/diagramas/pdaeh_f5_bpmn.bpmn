<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PDAEH-F5-general-v1" targetNamespace="http://pdaeh.org/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.1">
  <collaboration id="Collab_F5">
    <participant id="Pool_F5" name="F5 — Sistematización del Diseño (E7 → E8)" processRef="Process_F5" />
    <participant id="Pool_OGA_F5" name="Órgano de Gobierno Arquitectónico (OGA)" processRef="Process_OGA_F5" />
  </collaboration>
  <process id="Process_F5" name="Proceso F5 — Sistematización del Diseño" isExecutable="false">
    <laneSet id="LaneSet_F5">
      <lane id="Lane_AEP_F5" name="Arquitecto empresarial del proceso (AEP) /  Arquitectos Especialistas (ASP / AIP / ADP / ASecP / ETC)">
        <flowNodeRef>StartEvent_F5</flowNodeRef>
        <flowNodeRef>CA_F5_E7</flowNodeRef>
        <flowNodeRef>CA_F5_E8</flowNodeRef>
        <flowNodeRef>Task_F5_send</flowNodeRef>
        <flowNodeRef>Task_F5_adjust</flowNodeRef>
        <flowNodeRef>EndEvent_F5</flowNodeRef>
        <flowNodeRef>Gateway_F5_approval</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_F5" name="Inicio F5">
      <documentation>
        Inicio de F5 — Sistematización del Diseño.
        Precondición: Línea Base F4 aprobada por el OGA.
        Artefactos disponibles: DCO-v1, BER-v1, MTA-v5, DEA-v1, MAQ-v1.
        Flujo: E7 (Estilos y patrones arquitectónicos) → E8 (Patrones de diseño).
      </documentation>
      <outgoing>SF_F5_start_E7</outgoing>
    </startEvent>
    <callActivity id="CA_F5_E7" name="F5.E7. Estilos y patrones arquitectónicos" calledElement="Process_F5_E7">
      <documentation>
        Subproceso E7. Detalle en PDAEH_f5_E7_bpmn.xml.
        Roles: AEP, ASP, AIP/ADP, ASecP/ETC.
        Entradas: LBA-F3 (DEA-v1, MAQ-v1, MTA-v4), LBA-F4 (DCO-v1, BER-v1, MTA-v5).
        Salidas: CEP-v1 (Catálogo de Estilos y Patrones arquitectónicos), MTA-v6 (parcial).
      </documentation>
      <incoming>SF_F5_start_E7</incoming>
      <outgoing>SF_F5_E7_E8</outgoing>
      <property id="Prop_CA_E7" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_CA_E7_LBA_F4">
        <sourceRef>DOR_LBA_F4</sourceRef>
        <targetRef>Prop_CA_E7</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_CA_E7_CEP">
        <sourceRef>CA_F5_E7</sourceRef>
        <targetRef>DOR_CEP</targetRef>
      </dataOutputAssociation>
    </callActivity>
    <callActivity id="CA_F5_E8" name="F5.E8. Patrones de diseño" calledElement="Process_F5_E8">
      <documentation>
        Subproceso E8. Detalle en PDAEH_f5_E8_bpmn.xml.
        Roles: AEP, ASP, AIP/ADP, ASecP/ETC.
        Entradas: CEP-v1, DCO-v1, BER-v1, MTA-v6 (parcial).
        Salidas: CPD-v1 (Catálogo de Patrones de Diseño), MTA-v6 (final).
      </documentation>
      <incoming>SF_F5_E7_E8</incoming>
      <outgoing>SF_F5_E8_send</outgoing>
      <property id="Prop_CA_E8" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_CA_E8_LBA_F4">
        <sourceRef>DOR_LBA_F4</sourceRef>
        <targetRef>Prop_CA_E8</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_CA_E8_CEP">
        <sourceRef>DOR_CEP</sourceRef>
        <targetRef>Prop_CA_E8</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_CA_E8_CPD">
        <sourceRef>CA_F5_E8</sourceRef>
        <targetRef>DOR_CPD</targetRef>
      </dataOutputAssociation>
    </callActivity>
    <sendTask id="Task_F5_send" name="F5.E7.A6 {E8} Preparación y envío de artefactos al OGA" camunda:type="external" camunda:topic="OGA_Review_F5">
      <documentation>
        El AEP consolida CEP-v1, CPD-v1 y MTA-v6 en la LBA-F5 y envía al OGA para revisión formal.
      </documentation>
      <incoming>SF_F5_E8_send</incoming>
      <incoming>SF_F5_no_resend</incoming>
      <outgoing>SF_F5_send_adjust</outgoing>
      <property id="Prop_send_F5" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_send_CEP">
        <sourceRef>DOR_CEP</sourceRef>
        <targetRef>Prop_send_F5</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DIA_send_CPD">
        <sourceRef>DOR_CPD</sourceRef>
        <targetRef>Prop_send_F5</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_send_LBA_F5i">
        <sourceRef>Task_F5_send</sourceRef>
        <targetRef>DOR_LBA_F5i</targetRef>
      </dataOutputAssociation>
    </sendTask>
    <userTask id="Task_F5_adjust" name="F5.E7.A7 {E8} Ajustar artefactos según observaciones del OGA" camunda:assignee="AEP">
      <documentation>
        El AEP incorpora las observaciones del OGA sobre CEP-v1 y/o CPD-v1 según aplique,
        y actualiza la MTA-v6 con los cambios realizados antes del reenvío.
        Registrar las observaciones atendidas y el historial de cambios.
      </documentation>
      <incoming>SF_F5_send_adjust</incoming>
      <outgoing>SF_F5_adjust_gw</outgoing>
      <property id="Prop_adjust_F5" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_adjust_LBA_F5i">
        <sourceRef>DOR_LBA_F5i</sourceRef>
        <targetRef>Prop_adjust_F5</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_adjust_LBA_F5a">
        <sourceRef>Task_F5_adjust</sourceRef>
        <targetRef>DOR_LBA_F5a</targetRef>
      </dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="Gateway_F5_approval" name="¿OGA aprueba los artefactos?">
      <incoming>SF_F5_adjust_gw</incoming>
      <outgoing>SF_F5_approval_yes</outgoing>
      <outgoing>SF_F5_no_resend</outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_F5" name="Fin">
      <documentation>
        Fin de F5. LBA-F5 aprobada. Proceso PDAEH completado.
        Artefactos: CEP-v1, CPD-v1, MTA-v6.
        El sistema cuenta con un catálogo completo de estilos, patrones arquitectónicos y patrones de diseño.
      </documentation>
      <incoming>SF_F5_approval_yes</incoming>
    </endEvent>
    <dataObjectReference id="DOR_LBA_F4" name="LBA-F4" dataObjectRef="DO_LBA_F4" />
    <dataObject id="DO_LBA_F4" name="DCO-v1 / BER-v1 / MTA-v5 / DEA-v1 / MAQ-v1" />
    <dataObjectReference id="DOR_CEP" name="CEP" dataObjectRef="DO_CEP" />
    <dataObject id="DO_CEP" name="CEP-v1 (Catálogo de Estilos y Patrones arquitectónicos)" />
    <dataObjectReference id="DOR_CPD" name="CPD" dataObjectRef="DO_CPD" />
    <dataObject id="DO_CPD" name="CPD-v1 (Catálogo de Patrones de Diseño)" />
    <dataObjectReference id="DOR_LBA_F5i" name="LBA-F5&#10;inicial" dataObjectRef="DO_LBA_F5i" />
    <dataObject id="DO_LBA_F5i" name="LBA-F5 inicial" />
    <dataObjectReference id="DOR_LBA_F5a" name="LBA-F5 aprobada" dataObjectRef="DO_LBA_F5a" />
    <dataObject id="DO_LBA_F5a" name="LBA-F5 aprobada" />
    <sequenceFlow id="SF_F5_start_E7" sourceRef="StartEvent_F5" targetRef="CA_F5_E7" />
    <sequenceFlow id="SF_F5_E7_E8" sourceRef="CA_F5_E7" targetRef="CA_F5_E8" />
    <sequenceFlow id="SF_F5_E8_send" sourceRef="CA_F5_E8" targetRef="Task_F5_send" />
    <sequenceFlow id="SF_F5_send_adjust" name="La transición ocurre cuando se recibe la respuesta del OGA" sourceRef="Task_F5_send" targetRef="Task_F5_adjust" />
    <sequenceFlow id="SF_F5_adjust_gw" sourceRef="Task_F5_adjust" targetRef="Gateway_F5_approval" />
    <sequenceFlow id="SF_F5_no_resend" name="no" sourceRef="Gateway_F5_approval" targetRef="Task_F5_send">
      <conditionExpression>Requiere ajustes y reenvío</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SF_F5_approval_yes" name="Sí" sourceRef="Gateway_F5_approval" targetRef="EndEvent_F5">
      <conditionExpression>OGA aprueba LBA-F5</conditionExpression>
    </sequenceFlow>
  </process>
  <process id="Process_OGA_F5" name="Proceso OGA — Revisión F5" isExecutable="false">
    <laneSet id="LaneSet_OGA_F5">
      <lane id="Lane_OGA_F5" name="OGA — Órgano de Gobierno Arquitectónico">
        <flowNodeRef>OGA_F5_StartEvent</flowNodeRef>
        <flowNodeRef>OGA_F5_Act1</flowNodeRef>
        <flowNodeRef>OGA_F5_Act2</flowNodeRef>
        <flowNodeRef>OGA_F5_Act3</flowNodeRef>
        <flowNodeRef>OGA_F5_Act4</flowNodeRef>
        <flowNodeRef>OGA_F5_Act5</flowNodeRef>
        <flowNodeRef>OGA_F5_Act6</flowNodeRef>
        <flowNodeRef>OGA_F5_GW</flowNodeRef>
        <flowNodeRef>OGA_F5_GW_join</flowNodeRef>
        <flowNodeRef>OGA_F5_EndEvent</flowNodeRef>
      </lane>
    </laneSet>
    <dataObjectReference id="DOR_OGA_F5_LBA_recv" name="LBA-F5 inicial" dataObjectRef="DO_OGA_F5_LBA_recv" />
    <dataObject id="DO_OGA_F5_LBA_recv" />
    <dataObjectReference id="DOR_OGA_F5_Acta" name="Acta de decisión emitida por el OGA" dataObjectRef="DO_OGA_F5_Acta" />
    <dataObject id="DO_OGA_F5_Acta" />
    <dataObjectReference id="DOR_OGA_F5_LBA_upd" name="LBA-F5 actualizado" dataObjectRef="DO_OGA_F5_LBA_upd" />
    <dataObject id="DO_OGA_F5_LBA_upd" />
    <startEvent id="OGA_F5_StartEvent" name="Recepción de artefactos">
      <outgoing>OGA_F5_Flow_01</outgoing>
      <messageEventDefinition id="OGA_F5_MsgStart" />
    </startEvent>
    <userTask id="OGA_F5_Act1" name="1. Recepción y registro de artefactos" camunda:assignee="Secretaria_OGA">
      <documentation>La coordinación del OGA acusa recibo del paquete enviado por el AEP (CEP-v1, CPD-v1, MTA-v6), lo registra en la bitácora de revisiones y distribuye a los miembros del comité.</documentation>
      <incoming>OGA_F5_Flow_01</incoming>
      <outgoing>OGA_F5_Flow_02</outgoing>
      <dataOutputAssociation id="DOA_OGA_F5_Act1">
        <targetRef>DOR_OGA_F5_LBA_recv</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="OGA_F5_Act2" name="2. Convocatoria y agenda de sesión de revisión" camunda:assignee="Secretaria_OGA">
      <documentation>Se convoca la sesión formal del OGA, se establece la agenda de revisión y se confirma quórum. Plazo típico: 5 días hábiles desde la recepción.</documentation>
      <incoming>OGA_F5_Flow_02</incoming>
      <outgoing>OGA_F5_Flow_03</outgoing>
    </userTask>
    <userTask id="OGA_F5_Act3" name="3. Revisión individual de artefactos por miembros" camunda:assignee="Miembros_OGA">
      <documentation>Cada miembro del OGA revisa de forma individual los artefactos recibidos evaluando: (1) coherencia del CEP con estructuras y componentes de F3/F4, (2) cobertura de los dominios clásico, cuántico y cuántico-clásico en el CEP, (3) completitud y aplicabilidad del CPD, (4) trazabilidad de estilos y patrones con artefactos de fases anteriores, (5) consistencia de la MTA-v6.</documentation>
      <incoming>OGA_F5_Flow_03</incoming>
      <outgoing>OGA_F5_Flow_04</outgoing>
      <property id="Prop_OGA_F5_Act3" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_OGA_F5_Act3">
        <sourceRef>DOR_OGA_F5_LBA_recv</sourceRef>
        <targetRef>Prop_OGA_F5_Act3</targetRef>
      </dataInputAssociation>
    </userTask>
    <userTask id="OGA_F5_Act4" name="4. Sesión formal de deliberación y votación" camunda:assignee="Miembros_OGA">
      <documentation>El OGA se reúne formalmente. Los miembros exponen sus observaciones, se debate y se alcanza una decisión por votación o consenso: (A) Aprobado sin condiciones, (B) Aprobado con observaciones menores (el AEP las incorpora sin nueva revisión), (C) Requiere ajustes sustanciales y nueva revisión.</documentation>
      <incoming>OGA_F5_Flow_04</incoming>
      <outgoing>OGA_F5_Flow_05</outgoing>
    </userTask>
    <exclusiveGateway id="OGA_F5_GW" name="¿Aprueba los artefactos?">
      <incoming>OGA_F5_Flow_05</incoming>
      <outgoing>OGA_F5_Flow_yes</outgoing>
      <outgoing>OGA_F5_Flow_no</outgoing>
    </exclusiveGateway>
    <userTask id="OGA_F5_Act5" name="5. Emisión del acta de aprobación y notificación al AEP" camunda:assignee="Secretaria_OGA">
      <documentation>El OGA emite el acta formal de aprobación de la LBA-F5, la firma y notifica al AEP. Los catálogos CEP-v1 y CPD-v1 quedan autorizados para publicación en el repositorio corporativo. El proceso PDAEH queda formalmente completado.</documentation>
      <incoming>OGA_F5_Flow_yes</incoming>
      <outgoing>OGA_F5_Flow_06</outgoing>
      <dataOutputAssociation id="DOA_OGA_F5_Act5">
        <targetRef>DOR_OGA_F5_Acta</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="OGA_F5_Act6" name="6. Documentación de observaciones y envío al AEP" camunda:assignee="Secretaria_OGA">
      <documentation>El OGA documenta formalmente las observaciones y las envía al AEP con un plazo de respuesta. Cada observación indica el artefacto afectado (CEP o CPD), el criterio incumplido y la acción correctiva requerida.</documentation>
      <incoming>OGA_F5_Flow_no</incoming>
      <outgoing>OGA_F5_Flow_07</outgoing>
      <dataOutputAssociation id="DOA_OGA_F5_Act6">
        <targetRef>DOR_OGA_F5_Acta</targetRef>
      </dataOutputAssociation>
    </userTask>
    <parallelGateway id="OGA_F5_GW_join" name="7. Consolida los resultados">
      <incoming>OGA_F5_Flow_06</incoming>
      <incoming>OGA_F5_Flow_07</incoming>
      <outgoing>OGA_F5_Flow_08</outgoing>
    </parallelGateway>
    <endEvent id="OGA_F5_EndEvent" name="Decisión notificada al AEP">
      <incoming>OGA_F5_Flow_08</incoming>
      <property id="Prop_OGA_F5_End" name="__targetRef_placeholder" />
      <dataInputAssociation id="DIA_OGA_F5_End">
        <sourceRef>DOR_OGA_F5_LBA_upd</sourceRef>
        <targetRef>Prop_OGA_F5_End</targetRef>
      </dataInputAssociation>
      <messageEventDefinition id="OGA_F5_MsgEnd" />
    </endEvent>
    <sequenceFlow id="OGA_F5_Flow_01" sourceRef="OGA_F5_StartEvent" targetRef="OGA_F5_Act1" />
    <sequenceFlow id="OGA_F5_Flow_02" sourceRef="OGA_F5_Act1" targetRef="OGA_F5_Act2" />
    <sequenceFlow id="OGA_F5_Flow_03" sourceRef="OGA_F5_Act2" targetRef="OGA_F5_Act3" />
    <sequenceFlow id="OGA_F5_Flow_04" sourceRef="OGA_F5_Act3" targetRef="OGA_F5_Act4" />
    <sequenceFlow id="OGA_F5_Flow_05" sourceRef="OGA_F5_Act4" targetRef="OGA_F5_GW" />
    <sequenceFlow id="OGA_F5_Flow_yes" name="si" sourceRef="OGA_F5_GW" targetRef="OGA_F5_Act5">
      <conditionExpression>Aprobado</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="OGA_F5_Flow_no" name="no" sourceRef="OGA_F5_GW" targetRef="OGA_F5_Act6">
      <conditionExpression>Requiere ajustes</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="OGA_F5_Flow_06" sourceRef="OGA_F5_Act5" targetRef="OGA_F5_GW_join" />
    <sequenceFlow id="OGA_F5_Flow_07" sourceRef="OGA_F5_Act6" targetRef="OGA_F5_GW_join" />
    <sequenceFlow id="OGA_F5_Flow_08" sourceRef="OGA_F5_GW_join" targetRef="OGA_F5_EndEvent" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_F5">
    <bpmndi:BPMNPlane id="BPMNPlane_F5" bpmnElement="Collab_F5">
      <!-- Pool principal F5 -->
      <bpmndi:BPMNShape id="Sh_Pool_F5" bpmnElement="Pool_F5" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1600" height="390" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane_AEP_F5" bpmnElement="Lane_AEP_F5" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1570" height="390" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- Evento inicio -->
      <bpmndi:BPMNShape id="Sh_StartEvent_F5" bpmnElement="StartEvent_F5">
        <dc:Bounds x="242" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="325" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- CallActivity E7 -->
      <bpmndi:BPMNShape id="Sh_CA_F5_E7" bpmnElement="CA_F5_E7">
        <dc:Bounds x="340" y="260" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- CallActivity E8 -->
      <bpmndi:BPMNShape id="Sh_CA_F5_E8" bpmnElement="CA_F5_E8">
        <dc:Bounds x="610" y="260" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- SendTask envío OGA -->
      <bpmndi:BPMNShape id="Sh_Task_F5_send" bpmnElement="Task_F5_send">
        <dc:Bounds x="880" y="260" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- UserTask ajuste -->
      <bpmndi:BPMNShape id="Sh_Task_F5_adjust" bpmnElement="Task_F5_adjust">
        <dc:Bounds x="1220" y="260" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- Gateway aprobación -->
      <bpmndi:BPMNShape id="Sh_Gateway_F5_approval" bpmnElement="Gateway_F5_approval" isMarkerVisible="true">
        <dc:Bounds x="1535" y="265" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1523" y="227.5" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- Evento fin -->
      <bpmndi:BPMNShape id="Sh_EndEvent_F5" bpmnElement="EndEvent_F5">
        <dc:Bounds x="1632" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1642" y="315" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- Data objects principales -->
      <bpmndi:BPMNShape id="Sh_DOR_LBA_F4" bpmnElement="DOR_LBA_F4">
        <dc:Bounds x="322" y="155" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="321" y="215" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_DOR_CEP" bpmnElement="DOR_CEP">
        <dc:Bounds x="542" y="155" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="546" y="212" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_DOR_CPD" bpmnElement="DOR_CPD">
        <dc:Bounds x="732" y="155" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="738" y="131" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_DOR_LBA_F5i" bpmnElement="DOR_LBA_F5i">
        <dc:Bounds x="1122" y="125" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1121" y="182" width="38" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_DOR_LBA_F5a" bpmnElement="DOR_LBA_F5a">
        <dc:Bounds x="1402" y="125" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1378" y="182" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- Sequence flows principales -->
      <bpmndi:BPMNEdge id="Ed_SF_F5_start_E7" bpmnElement="SF_F5_start_E7">
        <di:waypoint x="278" y="300" />
        <di:waypoint x="340" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_SF_F5_E7_E8" bpmnElement="SF_F5_E7_E8">
        <di:waypoint x="540" y="300" />
        <di:waypoint x="610" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_SF_F5_E8_send" bpmnElement="SF_F5_E8_send">
        <di:waypoint x="810" y="300" />
        <di:waypoint x="880" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_SF_F5_send_adjust" bpmnElement="SF_F5_send_adjust">
        <di:waypoint x="1080" y="300" />
        <di:waypoint x="1220" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1108" y="315" width="85" height="66" />
        </bpmndi:BPMNLabel>
