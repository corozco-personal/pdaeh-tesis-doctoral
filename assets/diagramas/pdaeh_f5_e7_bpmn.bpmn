      </lane>
    </laneSet>
    <startEvent id="StartEvent_E7" name="Inicio">
      <outgoing>SF_E7_start_A1</outgoing>
    </startEvent>
    <userTask id="A1_E7" name="F5.E7.A1: Definición del marco de estilos arquitectónicos">
