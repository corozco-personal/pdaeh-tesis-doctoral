        <targetRef>Property_A1_E7</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_E7_A1_MEP">
        <targetRef>DataObjectReference_MEP</targetRef>
      </dataOutputAssociation>
    </userTask>
    <parallelGateway id="Gateway_E7_split" name="Especificación de estilos por rol">
