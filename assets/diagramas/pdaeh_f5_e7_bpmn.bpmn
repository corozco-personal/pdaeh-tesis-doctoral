      <outgoing>SF_E7_split_A2</outgoing>
      <outgoing>SF_E7_split_A3</outgoing>
      <outgoing>SF_E7_split_A4</outgoing>
    </parallelGateway>
    <userTask id="A2_E7" name="F5.E7.A2: Especificación de estilos transversales de la solución">
