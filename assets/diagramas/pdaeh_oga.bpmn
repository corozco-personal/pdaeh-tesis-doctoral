        <targetRef>Property_1hhsfem</targetRef>
      </dataInputAssociation>
      <messageEventDefinition id="MessageEventDefinition_1vf46zg" />
    </endEvent>
    <dataObjectReference id="DataObjectReference_0z7loav" name="LBA-Fx actualizado" dataObjectRef="DataObject_096dams" />
    <dataObject id="DataObject_096dams" />
